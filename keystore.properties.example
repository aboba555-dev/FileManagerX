# Copy to keystore.properties (git-ignored) and fill in to sign release builds.
# Create a key once:
#   keytool -genkeypair -v -keystore release.jks -alias filemanagerx -keyalg RSA -keysize 4096 -validity 10000
storeFile=release.jks
storePassword=change-me
keyAlias=filemanagerx
keyPassword=change-me
